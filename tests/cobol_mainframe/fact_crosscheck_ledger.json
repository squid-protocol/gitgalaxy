{
 "schema": "fact-crosscheck-ledger/1",
 "about": "Every known engine-vs-translator fact disagreement (tests/tools/fact_crosscheck.py, #4273): id -> cause. A cause names the side that is wrong (engine / translator / definitional) and its issue. A two-way ratchet: CI fails on a new disagreement AND on one listed here that no longer reproduces, so a PR that fixes a disagreement must lower this ledger (`fact_crosscheck.py update`) in the same PR. Triage new ones with `assign`.",
 "causes": {
  "cvda-dfhvalue": {
   "side": "definitional",
   "issue": 4273,
   "summary": "MOVE DFHVALUE(x) TO y: the engine records the operand as written (DFHVALUE), the translator its CVDA number (det/cvda.py). Same move."
  },
  "engine-drops-self-transfer": {
   "side": "definitional",
   "issue": 3362,
   "summary": "A GO TO back to its own paragraph (a read loop): the engine drops a unit's transfer to itself like recursion (#3362 contract, ground-truth ledger 'deliberate'); the translator and the key keep it."
  },
  "engine-main-line-no-extent": {
   "side": "engine",
   "issue": 4302,
   "summary": "The main line (statements before the first paragraph) has no extent in the engine (a synthetic calls-only unit, ground-truth ledger engine_main_line_in_no_unit); the translator's (MAIN) and the key have it."
  },
  "notation-decimal-comma": {
   "side": "definitional",
   "issue": 4664,
   "summary": "The same value in two notations, neither side wrong: under DECIMAL-POINT IS COMMA (estate-crucible DEUT ZINSBER) the engine reports a numeric literal as written (`0,5`, `1000,00`) and the translator as the number it models (`0.5`, `1000.00`; Item.decimal_comma, #4462). Seen since #4664 let ZINSBER translate (GEBÜHR / BETRÄGE)."
  },
  "numeric-value-spelling": {
   "side": "definitional",
   "issue": 4273,
   "summary": "A numeric VALUE as written (0225, 00: the engine and the key) vs as a number (225, 0: the translator parses it)."
  },
  "translator-copy-program-member": {
   "side": "definitional",
   "issue": 4460,
   "summary": "COPY SHPRATE / COPY ORDPRICE: by design no copy library of the estate holds the member, only a program source of that name (estate-crucible horror H-0053; its key: 'no compiler finds it'). The engine records the gap and the translator refuses the program by name (CopyUnresolved, #4468; before #4468 det.source spliced the program in, #4460). A correct refusal on both sides."
  },
  "translator-refuses-idms": {
   "side": "translator",
   "issue": 4532,
   "summary": "Refused by name since #4462 (source.unmodelled, 'IDMS DML not supported'): an IDMS-DC program (IDMS-CONTROL / SCHEMA SECTION; estate-crucible LOAN LNIDMS01). Its DML (BIND RUN-UNIT, READY, OBTAIN CALC, FINISH, DC RETURN) and subschema records are not modelled; IDMS support is #4532."
  },
  "translator-refuses-national-text": {
   "side": "translator",
   "issue": 4462,
   "summary": "Refused by name since #4462 (source.unmodelled), never laid out wrong: national / DBCS text (Kanji names and literals, PIC G, ideographic spaces: estate-crucible KYUY, decoded in its declared cp930 / shift_jis or UTF-8; the translator lays records out one byte a character; #4272). ZINSBER's DECIMAL-POINT IS COMMA is modelled since #4462 (test_det_programs DPCOMMA)."
  },
  "translator-refuses-source-defect": {
   "side": "definitional",
   "issue": 4462,
   "summary": "Refused by name since #4462 (layout._missing_period): a data entry with no period before the next level number (GenApp polloo2.cpy's 03 CA-CUSPOL-REQUEST). The source is defective; the engine reads past it, the translator never lays out a guess at it. Since #4735 also by name (source.cut_literal): program text past column 72 of a fixed-form line (a host variable cut short, a comma lost: NexusBank NEND-DAY), and a file that is a saved ISPF editor screen, not COBOL (source.NotCobol). Nothing to fix on either side."
  },
  "value-all-literal": {
   "side": "definitional",
   "issue": 4273,
   "summary": "VALUE ALL '#': the engine and the key record ALL, the translator ALL '#' (its value is the repeated literal)."
  }
 },
