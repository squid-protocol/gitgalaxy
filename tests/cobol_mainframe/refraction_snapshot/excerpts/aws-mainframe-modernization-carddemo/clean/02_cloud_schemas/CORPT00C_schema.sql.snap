CREATE TABLE DFHCOMMAREA (
    WS_PGMNAME                     VARCHAR(08),
    WS_TRANID                      VARCHAR(04),
    WS_MESSAGE                     VARCHAR(80),
    WS_ERR_FLG                     VARCHAR(01),
    WS_RESP_CD                     INTEGER,
    WS_REAS_CD                     INTEGER,
    WS_IDX                         SMALLINT,
    WS_REPORT_NAME                 VARCHAR(10),
    WS_START_DATE_YYYY             VARCHAR(04),
    WS_START_DATE_MM               VARCHAR(02),
    WS_START_DATE_DD               VARCHAR(02),
    WS_END_DATE_YYYY               VARCHAR(04),
    WS_END_DATE_MM                 VARCHAR(02),
    WS_END_DATE_DD                 VARCHAR(02),
    WS_DATE_FORMAT                 VARCHAR(10),
    WS_NUM_99                      SMALLINT,
    WS_NUM_9999                    SMALLINT,
    JCL_RECORD                     VARCHAR(80),
    PARM_START_DATE_1              VARCHAR(10),
    PARM_END_DATE_1                VARCHAR(10),
    PARM_START_DATE_2              VARCHAR(10),
    PARM_END_DATE_2                VARCHAR(10),
    JOB_LINES                      VARCHAR(80),
    CSUTLDTC_DATE                  VARCHAR(10),
    CSUTLDTC_DATE_FORMAT           VARCHAR(10),
    CSUTLDTC_RESULT_SEV_CD         VARCHAR(04),
    CSUTLDTC_RESULT_MSG_NUM        VARCHAR(04),
    CSUTLDTC_RESULT_MSG            VARCHAR(61)
);