package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "WS_ACCT_REISSUE_DATE")
public class Cbact01cWsAcctReissueDate {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "OUT_ACCT_ID")
    private Integer outAcctId;

    @Column(name = "OUT_ACCT_ACTIVE_STATUS", length = 1)
    private String outAcctActiveStatus;

    @Column(name = "OUT_ACCT_CURR_BAL", precision = 12, scale = 2)
    private BigDecimal outAcctCurrBal;

    @Column(name = "OUT_ACCT_CREDIT_LIMIT", precision = 12, scale = 2)
    private BigDecimal outAcctCreditLimit;

    @Column(name = "OUT_ACCT_CASH_CREDIT_LIMIT", precision = 12, scale = 2)
    private BigDecimal outAcctCashCreditLimit;

    @Column(name = "OUT_ACCT_OPEN_DATE", length = 10)
    private String outAcctOpenDate;

    @Column(name = "OUT_ACCT_EXPIRAION_DATE", length = 10)
    private String outAcctExpiraionDate;

    @Column(name = "OUT_ACCT_REISSUE_DATE", length = 10)
    private String outAcctReissueDate;

    @Column(name = "OUT_ACCT_CURR_CYC_CREDIT", precision = 12, scale = 2)
    private BigDecimal outAcctCurrCycCredit;

    @Column(name = "OUT_ACCT_CURR_CYC_DEBIT", precision = 12, scale = 2)
    private BigDecimal outAcctCurrCycDebit;

    @Column(name = "OUT_ACCT_GROUP_ID", length = 10)
    private String outAcctGroupId;

    @Column(name = "ARR_ACCT_ID")
    private Integer arrAcctId;

    @Column(name = "ARR_ACCT_CURR_BAL", precision = 12, scale = 2)
    private BigDecimal arrAcctCurrBal;

    @Column(name = "ARR_ACCT_CURR_CYC_DEBIT", precision = 12, scale = 2)
    private BigDecimal arrAcctCurrCycDebit;

    @Column(name = "VBR_REC", length = 80)
    private String vbrRec;

    @Column(name = "IO_STAT1", length = 1)
    private String ioStat1;

    @Column(name = "IO_STAT2", length = 1)
    private String ioStat2;

    @Column(name = "TWO_BYTES_BINARY")
    private Integer twoBytesBinary;

    @Column(name = "TWO_BYTES_RIGHT", length = 1)
    private String twoBytesRight;

    @Column(name = "IO_STATUS_0403")
    private Integer ioStatus0403;

    @Column(name = "APPL_RESULT")
    private Integer applResult;

    @Column(name = "END_OF_FILE", length = 1)
    private String endOfFile;

    @Column(name = "ABCODE")
    private Integer abcode;

    @Column(name = "TIMING")
    private Integer timing;

    @Column(name = "WS_RECD_LEN")
    private Integer wsRecdLen;

    @Column(name = "VB1_ACCT_ID")
    private Integer vb1AcctId;

    @Column(name = "VB1_ACCT_ACTIVE_STATUS", length = 1)
    private String vb1AcctActiveStatus;

    @Column(name = "VB2_ACCT_ID")
    private Integer vb2AcctId;

    @Column(name = "VB2_ACCT_CURR_BAL", precision = 12, scale = 2)
    private BigDecimal vb2AcctCurrBal;

    @Column(name = "VB2_ACCT_CREDIT_LIMIT", precision = 12, scale = 2)
    private BigDecimal vb2AcctCreditLimit;

    @Column(name = "VB2_ACCT_REISSUE_YYYY", length = 4)
    private String vb2AcctReissueYyyy;

    @Column(name = "WS_ACCT_REISSUE_YYYY", length = 4)
    private String wsAcctReissueYyyy;

    @Column(name = "WS_REISSUE_DATE", length = 10)
    private String wsReissueDate;

}