package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "DFHCOMMAREA")
public class Dfhcommarea {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "WS_RESP_CD")
    private Integer wsRespCd;

    @Column(name = "WS_REAS_CD")
    private Integer wsReasCd;

    @Column(name = "WS_TRANID")
    private String wsTranid;

    @Column(name = "WS_EDIT_SELECT_FLAGS")
    private String wsEditSelectFlags = "N/A";

    @Column(name = "WS_EDIT_SELECT")
    private String wsEditSelect;

    @Column(name = "WS_EDIT_SELECT_ERROR_FLAGS")
    private String wsEditSelectErrorFlags = "N/A";

    @Column(name = "WS_ROW_CRDSELECT_ERROR")
    private String wsRowCrdselectError;

    @Column(name = "I")
    private Integer i;

    @Column(name = "I_SELECTED")
    private Integer iSelected;

    @Column(name = "FLG_PROTECT_SELECT_ROWS")
    private String flgProtectSelectRows;

    @Column(name = "WS_LONG_MSG")
    private String wsLongMsg;

    @Column(name = "WS_INFO_MSG")
    private String wsInfoMsg;

    @Column(name = "WS_ERROR_MSG")
    private String wsErrorMsg;

    @Column(name = "WS_CARD_RID_CARDNUM")
    private String wsCardRidCardnum;

    @Column(name = "WS_CARD_RID_ACCT_ID")
    private BigDecimal wsCardRidAcctId;

    @Column(name = "WS_SCRN_COUNTER")
    private Integer wsScrnCounter;

    @Column(name = "ERROR_OPNAME")
    private String errorOpname;

    @Column(name = "ERROR_FILE")
    private String errorFile;

    @Column(name = "ERROR_RESP")
    private String errorResp;

    @Column(name = "ERROR_RESP2")
    private String errorResp2;

    @Column(name = "WS_MAX_SCREEN_LINES")
    private Integer wsMaxScreenLines;

    @Column(name = "LIT_THISPGM")
    private String litThispgm;

    @Column(name = "LIT_THISTRANID")
    private String litThistranid;

    @Column(name = "LIT_THISMAPSET")
    private String litThismapset;

    @Column(name = "LIT_THISMAP")
    private String litThismap;

    @Column(name = "LIT_MENUPGM")
    private String litMenupgm;

    @Column(name = "LIT_MENUMAPSET")
    private String litMenumapset;

    @Column(name = "LIT_CARDDTLPGM")
    private String litCarddtlpgm;

    @Column(name = "LIT_CARDDTLMAPSET")
    private String litCarddtlmapset;

    @Column(name = "LIT_CARDDTLMAP")
    private String litCarddtlmap;

    @Column(name = "LIT_CARDUPDPGM")
    private String litCardupdpgm;

    @Column(name = "LIT_CARDUPDMAPSET")
    private String litCardupdmapset;

    @Column(name = "LIT_CARDUPDMAP")
    private String litCardupdmap;

    @Column(name = "LIT_CARD_FILE")
    private String litCardFile;

    @Column(name = "WS_CA_LAST_CARD_NUM")
    private String wsCaLastCardNum;

    @Column(name = "WS_CA_LAST_CARD_ACCT_ID")
    private BigDecimal wsCaLastCardAcctId;

    @Column(name = "WS_CA_FIRST_CARD_NUM")
    private String wsCaFirstCardNum;

    @Column(name = "WS_CA_FIRST_CARD_ACCT_ID")
    private BigDecimal wsCaFirstCardAcctId;

    @Column(name = "WS_CA_SCREEN_NUM")
    private BigDecimal wsCaScreenNum;

    @Column(name = "WS_CA_LAST_PAGE_DISPLAYED")
    private BigDecimal wsCaLastPageDisplayed;

    @Column(name = "WS_CA_NEXT_PAGE_IND")
    private String wsCaNextPageInd;

    @Column(name = "WS_RETURN_FLAG")
    private String wsReturnFlag = "N/A";

    @Column(name = "WS_ALL_ROWS")
    private String wsAllRows;

    @Column(name = "WS_ROW_ACCTNO")
    private String wsRowAcctno;

    @Column(name = "WS_ROW_CARD_NUM")
    private String wsRowCardNum;

    @Column(name = "WS_ROW_CARD_STATUS")
    private String wsRowCardStatus;

    @Column(name = "WS_COMMAREA")
    private String wsCommarea;

}