package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "CHILD_TOKENS")
public class Csstats2ChildTokens {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "CUST_NO_IN", length = 4)
    private String custNoIn;

    @Column(name = "CUSTOMER_IMPORTANCE", length = 8)
    private String customerImportance;

    @Column(name = "INPUT_CONTAINER", length = 16)
    private String inputContainer;

    @Column(name = "CSSTATS2_CONTAINER", length = 16)
    private String csstats2Container;

    @Column(name = "GETPOL", length = 8)
    private String getpol;

    @Column(name = "GETSPND", length = 8)
    private String getspnd;

    @Column(name = "COMMAND_RESP")
    private Integer commandResp;

    @Column(name = "COMMAND_RESP2")
    private Integer commandResp2;

    @Column(name = "GET_POLICY_TRAN", length = 4)
    private String getPolicyTran;

    @Column(name = "GET_SPEND_TRAN", length = 4)
    private String getSpendTran;

    @Column(name = "GET_POLICY_TKN", length = 16)
    private String getPolicyTkn;

    @Column(name = "GET_SPEND_TKN", length = 16)
    private String getSpendTkn;

}