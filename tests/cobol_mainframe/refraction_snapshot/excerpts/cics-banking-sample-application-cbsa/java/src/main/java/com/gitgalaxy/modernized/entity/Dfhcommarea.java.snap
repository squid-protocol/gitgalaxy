package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "DFHCOMMAREA")
public class Dfhcommarea {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "WS_CICS_RESP")
    private Integer wsCicsResp;

    @Column(name = "WS_CICS_RESP2")
    private Integer wsCicsResp2;

    @Column(name = "WS_CICS_FAIL_MSG")
    private String wsCicsFailMsg;

    @Column(name = "WS_CICS_RESP_DISP")
    private Integer wsCicsRespDisp;

    @Column(name = "WS_CICS_RESP2_DISP")
    private Integer wsCicsResp2Disp;

    @Column(name = "VALID_DATA_SW")
    private String validDataSw;

    @Column(name = "END_OF_SESSION_MESSAGE")
    private String endOfSessionMessage;

    @Column(name = "WS_COMM_CUSTNO")
    private BigDecimal wsCommCustno;

    @Column(name = "WS_COMM_ACCTYPE")
    private String wsCommAcctype;

    @Column(name = "WS_COMM_INTRT")
    private BigDecimal wsCommIntrt;

    @Column(name = "WS_COMM_OVERDR")
    private BigDecimal wsCommOverdr;

    @Column(name = "NSTMTDD_NUM")
    private BigDecimal nstmtddNum;

    @Column(name = "NSTMTMMI_NUM")
    private BigDecimal nstmtmmiNum;

    @Column(name = "NSTMTYYI_NUM")
    private BigDecimal nstmtyyiNum;

    @Column(name = "NST_NUM")
    private BigDecimal nstNum;

    @Column(name = "INTRT_PIC9")
    private BigDecimal intrtPic9;

    @Column(name = "WS_NUM_COUNT_POINT")
    private Integer wsNumCountPoint;

    @Column(name = "WS_NUM_COUNT_TOTAL")
    private Integer wsNumCountTotal;

    @Column(name = "WS_REVERSE")
    private String wsReverse;

    @Column(name = "SUBPGM_EYECATCHER")
    private String subpgmEyecatcher;

    @Column(name = "SUBPGM_CUSTNO")
    private BigDecimal subpgmCustno;

    @Column(name = "SUBPGM_SORTCODE")
    private Integer subpgmSortcode;

    @Column(name = "SUBPGM_NUMBER")
    private Integer subpgmNumber;

    @Column(name = "SUBPGM_ACC_TYPE")
    private String subpgmAccType;

    @Column(name = "SUBPGM_INT_RT")
    private BigDecimal subpgmIntRt;

    @Column(name = "SUBPGM_OPENED")
    private BigDecimal subpgmOpened;

    @Column(name = "SUBPGM_OVERDR_LIM")
    private BigDecimal subpgmOverdrLim;

    @Column(name = "SUBPGM_LAST_STMT_DT")
    private BigDecimal subpgmLastStmtDt;

    @Column(name = "SUBPGM_NEXT_STMT_DT")
    private BigDecimal subpgmNextStmtDt;

    @Column(name = "SUBPGM_AVAIL_BAL")
    private BigDecimal subpgmAvailBal;

    @Column(name = "SUBPGM_ACT_BAL")
    private BigDecimal subpgmActBal;

    @Column(name = "SUBPGM_SUCCESS")
    private String subpgmSuccess;

    @Column(name = "SUBPGM_FAIL_CODE")
    private String subpgmFailCode;

    @Column(name = "WS_U_TIME")
    private Integer wsUTime;

    @Column(name = "WS_ORIG_DATE")
    private String wsOrigDate;

    @Column(name = "WS_TIME_NOW")
    private BigDecimal wsTimeNow;

    @Column(name = "WS_TIME_NOW_GRP_HH")
    private BigDecimal wsTimeNowGrpHh;

    @Column(name = "WS_TIME_NOW_GRP_MM")
    private BigDecimal wsTimeNowGrpMm;

    @Column(name = "WS_TIME_NOW_GRP_SS")
    private BigDecimal wsTimeNowGrpSs;

    @Column(name = "WS_ABEND_PGM")
    private String wsAbendPgm;

    @Column(name = "COMM_CUSTNO")
    private BigDecimal commCustno;

    @Column(name = "COMM_ACCTYPE")
    private String commAcctype;

    @Column(name = "COMM_INTRT")
    private BigDecimal commIntrt;

    @Column(name = "COMM_OVERDR")
    private BigDecimal commOverdr;

}