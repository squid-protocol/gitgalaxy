package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "WS_WORK_AMOUNTS")
public class EpsnbrvlWsWorkAmounts {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "ERROR_INDICATOR")
    private Integer errorIndicator;

    @Column(name = "ERROR_TEXT", length = 80)
    private String errorText;

    @Column(name = "WS_LEADING_SPACES")
    private Integer wsLeadingSpaces;

    @Column(name = "WS_TRAILING_SPACES")
    private Integer wsTrailingSpaces;

    @Column(name = "WS_END_SPACE")
    private Integer wsEndSpace;

    @Column(name = "WS_DECIMAL_SPACE")
    private Integer wsDecimalSpace;

    @Column(name = "WS_IDX")
    private Integer wsIdx;

    @Column(name = "WS_DEC_IDX")
    private Integer wsDecIdx;

    @Column(name = "WS_NUM_IDX")
    private Integer wsNumIdx;

    @Column(name = "WS_MAX_FIELD")
    private Integer wsMaxField;

}