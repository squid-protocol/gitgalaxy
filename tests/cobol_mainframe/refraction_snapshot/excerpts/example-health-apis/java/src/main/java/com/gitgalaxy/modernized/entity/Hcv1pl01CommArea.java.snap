package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "COMM_AREA")
public class Hcv1pl01CommArea {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "WS_RESP")
    private Integer wsResp;

    @Column(name = "INQ_TRANS", length = 4)
    private String inqTrans;

    @Column(name = "ADD_TRANS", length = 4)
    private String addTrans;

    @Column(name = "MSGEND", length = 24)
    private String msgend;

}