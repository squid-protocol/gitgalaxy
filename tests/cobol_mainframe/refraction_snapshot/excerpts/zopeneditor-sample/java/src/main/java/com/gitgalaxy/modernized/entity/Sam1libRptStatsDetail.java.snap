package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "RPT_STATS_DETAIL")
public class Sam1libRptStatsDetail {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "REPORT_RECORD", length = 132)
    private String reportRecord;

    @Column(name = "WS_CUSTFILE_STATUS", length = 2)
    private String wsCustfileStatus;

    @Column(name = "WS_CUSTOUT_STATUS", length = 2)
    private String wsCustoutStatus;

    @Column(name = "WS_TRANFILE_STATUS", length = 2)
    private String wsTranfileStatus;

    @Column(name = "WS_REPORT_STATUS", length = 2)
    private String wsReportStatus;

    @Column(name = "WS_TRAN_EOF", length = 1)
    private String wsTranEof;

    @Column(name = "WS_TRAN_OK", length = 1)
    private String wsTranOk;

    @Column(name = "WS_CUST_FILE_EOF", length = 1)
    private String wsCustFileEof;

    @Column(name = "WS_TRAN_MSG", length = 50)
    private String wsTranMsg;

    @Column(name = "WS_PREV_TRAN_KEY", length = 13)
    private String wsPrevTranKey;

    @Column(name = "SAM2", length = 8)
    private String sam2;

    @Column(name = "I")
    private Integer i;

    @Column(name = "ERR_MSG_DATA1", length = 35)
    private String errMsgData1;

    @Column(name = "ERR_MSG_DATA2", length = 66)
    private String errMsgData2;

    @Column(name = "ERR_MSG_DATA3", length = 80)
    private String errMsgData3;

    @Column(name = "RPT_MM")
    private Integer rptMm;

    @Column(name = "RPT_DD")
    private Integer rptDd;

    @Column(name = "RPT_YY")
    private Integer rptYy;

    @Column(name = "RPT_HH")
    private Integer rptHh;

    @Column(name = "RPT_MIN")
    private Integer rptMin;

    @Column(name = "RPT_SS")
    private Integer rptSs;

    @Column(name = "RPT_TRAN_MSG1", length = 31)
    private String rptTranMsg1;

    @Column(name = "RPT_TRAN_RECORD", length = 80)
    private String rptTranRecord;

    @Column(name = "RPT_TRAN", length = 10)
    private String rptTran;

    @Column(name = "RPT_NUM_TRANS")
    private Integer rptNumTrans;

    @Column(name = "RPT_NUM_TRAN_PROC")
    private Integer rptNumTranProc;

    @Column(name = "RPT_NUM_TRAN_ERR")
    private Integer rptNumTranErr;

}