CREATE TABLE WS_EXPORT_STATISTICS (
    EXPORT_OUTPUT_RECORD           VARCHAR(500),
    WS_CUSTOMER_STATUS             VARCHAR(02),
    WS_ACCOUNT_STATUS              VARCHAR(02),
    WS_XREF_STATUS                 VARCHAR(02),
    WS_TRANSACTION_STATUS          VARCHAR(02),
    WS_CARD_STATUS                 VARCHAR(02),
    WS_EXPORT_STATUS               VARCHAR(02),
    WS_EXPORT_DATE                 VARCHAR(10),
    WS_EXPORT_TIME                 VARCHAR(08),
    WS_FORMATTED_TIMESTAMP         VARCHAR(26),
    WS_SEQUENCE_COUNTER            INTEGER,
    WS_CURR_YEAR                   SMALLINT,
    WS_CURR_MONTH                  SMALLINT,
    WS_CURR_DAY                    SMALLINT,
    WS_CURR_HOUR                   SMALLINT,
    WS_CURR_MINUTE                 SMALLINT,
    WS_CURR_SECOND                 SMALLINT,
    WS_CURR_HUNDREDTH              SMALLINT,
    WS_CUSTOMER_RECORDS_EXPORTED   INTEGER,
    WS_ACCOUNT_RECORDS_EXPORTED    INTEGER,
    WS_XREF_RECORDS_EXPORTED       INTEGER,
    WS_TRAN_RECORDS_EXPORTED       INTEGER,
    WS_CARD_RECORDS_EXPORTED       INTEGER,
    WS_TOTAL_RECORDS_EXPORTED      INTEGER
);