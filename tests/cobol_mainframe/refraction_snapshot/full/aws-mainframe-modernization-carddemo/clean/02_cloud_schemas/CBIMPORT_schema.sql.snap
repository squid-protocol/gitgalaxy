CREATE TABLE WS_ERROR_RECORD (
    ERROR_OUTPUT_RECORD            VARCHAR(132),
    WS_EXPORT_STATUS               VARCHAR(02),
    WS_CUSTOMER_STATUS             VARCHAR(02),
    WS_ACCOUNT_STATUS              VARCHAR(02),
    WS_XREF_STATUS                 VARCHAR(02),
    WS_TRANSACTION_STATUS          VARCHAR(02),
    WS_CARD_STATUS                 VARCHAR(02),
    WS_ERROR_STATUS                VARCHAR(02),
    WS_IMPORT_DATE                 VARCHAR(10),
    WS_IMPORT_TIME                 VARCHAR(08),
    WS_TOTAL_RECORDS_READ          INTEGER,
    WS_CUSTOMER_RECORDS_IMPORTED   INTEGER,
    WS_ACCOUNT_RECORDS_IMPORTED    INTEGER,
    WS_XREF_RECORDS_IMPORTED       INTEGER,
    WS_TRAN_RECORDS_IMPORTED       INTEGER,
    WS_CARD_RECORDS_IMPORTED       INTEGER,
    WS_ERROR_RECORDS_WRITTEN       INTEGER,
    WS_UNKNOWN_RECORD_TYPE_COUNT   INTEGER,
    ERR_TIMESTAMP                  VARCHAR(26),
    ERR_RECORD_TYPE                VARCHAR(01),
    ERR_SEQUENCE                   INTEGER,
    ERR_MESSAGE                    VARCHAR(50)
);