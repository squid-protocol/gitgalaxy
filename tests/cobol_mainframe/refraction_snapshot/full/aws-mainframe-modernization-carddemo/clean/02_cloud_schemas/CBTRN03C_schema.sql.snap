CREATE TABLE IO_STATUS_04 (
    FD_XREF_CARD_NUM               VARCHAR(16),
    FD_TRAN_TYPE                   VARCHAR(02),
    FD_TRAN_TYPE_CD                VARCHAR(02),
    FD_TRAN_CAT_CD                 SMALLINT,
    FD_REPTFILE_REC                VARCHAR(133),
    WS_START_DATE                  VARCHAR(10),
    WS_END_DATE                    VARCHAR(10),
    WS_FIRST_TIME                  VARCHAR(1),
    WS_LINE_COUNTER                INTEGER -- Legacy: COMP-3 (Packed Decimal),
    WS_PAGE_SIZE                   SMALLINT -- Legacy: COMP-3 (Packed Decimal),
    WS_BLANK_LINE                  VARCHAR(133),
    WS_PAGE_TOTAL                  DECIMAL(11, 2),
    WS_ACCOUNT_TOTAL               DECIMAL(11, 2),
    WS_GRAND_TOTAL                 DECIMAL(11, 2),
    WS_CURR_CARD_NUM               VARCHAR(16),
    IO_STAT1                       VARCHAR(1),
    IO_STAT2                       VARCHAR(1),
    TWO_BYTES_BINARY               SMALLINT,
    TWO_BYTES_RIGHT                VARCHAR(1),
    IO_STATUS_0403                 SMALLINT,
    APPL_RESULT                    INTEGER,
    END_OF_FILE                    VARCHAR(01),
    ABCODE                         INTEGER,
    TIMING                         INTEGER
);