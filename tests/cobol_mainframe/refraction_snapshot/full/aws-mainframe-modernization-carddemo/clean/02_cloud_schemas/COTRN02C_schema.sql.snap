    WS_TRAN_AMT                    DECIMAL(10, 2),
    WS_ACCT_ID_N                   BIGINT,
    WS_CARD_NUM_N                  BIGINT,
    WS_TRAN_ID_N                   BIGINT,
    WS_TRAN_AMT_N                  DECIMAL(11, 2),
    WS_TRAN_AMT_E                  DECIMAL(10, 2),
    WS_DATE_FORMAT                 VARCHAR(10),
    CSUTLDTC_DATE                  VARCHAR(10),
    CSUTLDTC_DATE_FORMAT           VARCHAR(10),
    CSUTLDTC_RESULT_SEV_CD         VARCHAR(04),
    CSUTLDTC_RESULT_MSG_NUM        VARCHAR(04),
    CSUTLDTC_RESULT_MSG            VARCHAR(61),
    CDEMO_CT02_TRNID_FIRST         VARCHAR(16),
    CDEMO_CT02_TRNID_LAST          VARCHAR(16),
    CDEMO_CT02_PAGE_NUM            INTEGER,
    CDEMO_CT02_NEXT_PAGE_FLG       VARCHAR(01),
