    WS_EDIT_VARIABLE_NAME          VARCHAR(25),
    WS_EDIT_ALPHANUM_ONLY          VARCHAR(256),
    WS_EDIT_ALPHANUM_LENGTH        SMALLINT -- Legacy: COMP-3 (Packed Decimal),
    WS_EDIT_ALPHANUM_ONLY_FLAGS    VARCHAR(1),
    WS_DISP_SQLCODE                SMALLINT,
    WS_STRING_MID                  SMALLINT,
    WS_STRING_LEN                  SMALLINT,
    WS_STRING_OUT                  VARCHAR(40),
    WS_EDIT_TTYP_FLAG              VARCHAR(1),
    WS_EDIT_DESC_FLAGS             VARCHAR(1),
    WS_EDIT_DATE_X_YEAR            VARCHAR(4),
    WS_EDIT_DATE_MONTH             VARCHAR(2),
    WS_EDIT_DATE_DAY               VARCHAR(2),
    WS_EDIT_NUMERIC_2              SMALLINT,
    WS_EDIT_ALPHANUMERIC_2         VARCHAR(02),
    TTUP_UPDATE_TTYP_TYPE          VARCHAR(02),
    TTUP_UPDATE_TTYP_TYPE_DESC     VARCHAR(50),
    WS_INFO_MSG                    VARCHAR(40),
    WS_RETURN_MSG                  VARCHAR(75),
    LIT_THISPGM                    VARCHAR(8),
    LIT_THISTRANID                 VARCHAR(4),
    LIT_THISMAPSET                 VARCHAR(8),
    LIT_THISMAP                    VARCHAR(7),
    LIT_ADMINPGM                   VARCHAR(8),
    LIT_ADMINTRANID                VARCHAR(4),
    LIT_LISTTPGM                   VARCHAR(8),
    LIT_UPPER                      VARCHAR(26),
    LIT_LOWER                      VARCHAR(26),
    LIT_NUMBERS                    VARCHAR(10),
    LIT_ALL_ALPHANUM_FROM          VARCHAR(62),
    LIT_ALPHANUM_SPACES_TO         VARCHAR(62),
    TTUP_CHANGE_ACTION             VARCHAR(1),
    TTUP_OLD_TTYP_TYPE             VARCHAR(02),
    TTUP_OLD_TTYP_TYPE_DESC        VARCHAR(50),
    TTUP_NEW_TTYP_TYPE             VARCHAR(02),
    TTUP_NEW_TTYP_TYPE_DESC        VARCHAR(50),
    WS_COMMAREA                    VARCHAR(2000)
);