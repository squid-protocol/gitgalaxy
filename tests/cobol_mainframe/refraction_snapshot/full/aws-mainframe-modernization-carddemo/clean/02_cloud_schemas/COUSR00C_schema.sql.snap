    WS_TRANID                      VARCHAR(04),
    WS_MESSAGE                     VARCHAR(80),
    WS_USRSEC_FILE                 VARCHAR(08),
    WS_ERR_FLG                     VARCHAR(01),
    WS_RESP_CD                     INTEGER,
    WS_REAS_CD                     INTEGER,
    WS_IDX                         SMALLINT,
    CDEMO_CU00_USRID_FIRST         VARCHAR(08),
    CDEMO_CU00_USRID_LAST          VARCHAR(08),
    CDEMO_CU00_PAGE_NUM            INTEGER,
    CDEMO_CU00_NEXT_PAGE_FLG       VARCHAR(01),
    CDEMO_CU00_USR_SEL_FLG         VARCHAR(01),
    CDEMO_CU00_USR_SELECTED        VARCHAR(08)
);