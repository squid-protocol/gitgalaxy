    WS_ERR_FLG                     VARCHAR(01),
    WS_RESP_CD                     INTEGER,
    WS_REAS_CD                     INTEGER,
    CDEMO_CU03_USRID_FIRST         VARCHAR(08),
    CDEMO_CU03_USRID_LAST          VARCHAR(08),
    CDEMO_CU03_PAGE_NUM            INTEGER,
    CDEMO_CU03_NEXT_PAGE_FLG       VARCHAR(01),
    CDEMO_CU03_USR_SEL_FLG         VARCHAR(01),
    CDEMO_CU03_USR_SELECTED        VARCHAR(08)
);