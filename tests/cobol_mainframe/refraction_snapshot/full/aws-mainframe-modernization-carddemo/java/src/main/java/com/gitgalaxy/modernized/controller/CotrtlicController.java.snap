@RequiredArgsConstructor
public class CotrtlicController {

    private final CotrtlicService cotrtlicService;

    @PostMapping("/execute")
    public ResponseEntity<?> executeCotrtlic(
        /* No external data dependencies detected */
    ) {
        // TRANSACTIONAL PARADIGM DETECTED
        cotrtlicService.executeCotrtlic(/* pass DTOs here */);

