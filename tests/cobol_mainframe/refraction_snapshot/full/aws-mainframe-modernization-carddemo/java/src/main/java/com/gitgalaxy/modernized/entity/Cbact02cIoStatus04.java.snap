package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "IO_STATUS_04")
public class Cbact02cIoStatus04 {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "IO_STAT1")
    private String ioStat1;

    @Column(name = "IO_STAT2")
    private String ioStat2;

    @Column(name = "TWO_BYTES_BINARY")
    private Integer twoBytesBinary;

    @Column(name = "TWO_BYTES_RIGHT")
    private String twoBytesRight;

    @Column(name = "IO_STATUS_0403")
    private Integer ioStatus0403;

    @Column(name = "APPL_RESULT")
    private Integer applResult;

    @Column(name = "END_OF_FILE")
    private String endOfFile;

    @Column(name = "ABCODE")
    private Integer abcode;

    @Column(name = "TIMING")
    private Integer timing;

}