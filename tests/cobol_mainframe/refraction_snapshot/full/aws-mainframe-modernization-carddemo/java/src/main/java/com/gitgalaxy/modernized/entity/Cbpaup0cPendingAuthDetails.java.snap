package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "PENDING_AUTH_DETAILS")
public class Cbpaup0cPendingAuthDetails {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "CURRENT_DATE")
    private Integer currentDate;

    @Column(name = "CURRENT_YYDDD")
    private Integer currentYyddd;

    @Column(name = "WS_AUTH_DATE")
    private Integer wsAuthDate;

    @Column(name = "WS_EXPIRY_DAYS")
    private Integer wsExpiryDays;

    @Column(name = "WS_DAY_DIFF")
    private Integer wsDayDiff;

    @Column(name = "WS_CURR_APP_ID")
    private Integer wsCurrAppId;

    @Column(name = "WS_NO_CHKP")
    private Integer wsNoChkp;

    @Column(name = "WS_AUTH_SMRY_PROC_CNT")
    private Integer wsAuthSmryProcCnt;

    @Column(name = "WS_NO_SUMRY_READ")
    private Integer wsNoSumryRead;

    @Column(name = "WS_NO_SUMRY_DELETED")
    private Integer wsNoSumryDeleted;

    @Column(name = "WS_NO_DTL_READ")
    private Integer wsNoDtlRead;

    @Column(name = "WS_NO_DTL_DELETED")
    private Integer wsNoDtlDeleted;

    @Column(name = "WK_CHKPT_ID_CTR")
    private Integer wkChkptIdCtr;

    @Column(name = "PAUT_PCB_NUM")
    private Integer pautPcbNum;

    @Column(name = "P_EXPIRY_DAYS")
    private Integer pExpiryDays;

    @Column(name = "P_CHKP_FREQ")
    private String pChkpFreq;

    @Column(name = "P_CHKP_DIS_FREQ")
    private String pChkpDisFreq;

    @Column(name = "P_DEBUG_FLAG")
    private String pDebugFlag = "N/A";

    @Column(name = "IO_PCB_MASK")
    private String ioPcbMask;

    @Column(name = "PGM_PCB_MASK")
    private String pgmPcbMask;

}