package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "IO_STATUS_04")
public class Cbtrn03cIoStatus04 {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "FD_XREF_CARD_NUM", length = 16)
    private String fdXrefCardNum;

    @Column(name = "FD_TRAN_TYPE", length = 2)
    private String fdTranType;

    @Column(name = "FD_TRAN_TYPE_CD", length = 2)
    private String fdTranTypeCd;

    @Column(name = "FD_TRAN_CAT_CD")
    private Integer fdTranCatCd;

    @Column(name = "FD_REPTFILE_REC", length = 133)
    private String fdReptfileRec;

    @Column(name = "WS_START_DATE", length = 10)
    private String wsStartDate;

    @Column(name = "WS_END_DATE", length = 10)
    private String wsEndDate;

    @Column(name = "WS_FIRST_TIME", length = 1)
    private String wsFirstTime;

    @Column(name = "WS_LINE_COUNTER")
    private Integer wsLineCounter;

    @Column(name = "WS_PAGE_SIZE")
    private Integer wsPageSize;

    @Column(name = "WS_BLANK_LINE", length = 133)
    private String wsBlankLine;

    @Column(name = "WS_PAGE_TOTAL", precision = 11, scale = 2)
    private BigDecimal wsPageTotal;

    @Column(name = "WS_ACCOUNT_TOTAL", precision = 11, scale = 2)
    private BigDecimal wsAccountTotal;

    @Column(name = "WS_GRAND_TOTAL", precision = 11, scale = 2)
    private BigDecimal wsGrandTotal;

    @Column(name = "WS_CURR_CARD_NUM", length = 16)
    private String wsCurrCardNum;

    @Column(name = "IO_STAT1", length = 1)
    private String ioStat1;

    @Column(name = "IO_STAT2", length = 1)
    private String ioStat2;

    @Column(name = "TWO_BYTES_BINARY")
    private Integer twoBytesBinary;

    @Column(name = "TWO_BYTES_RIGHT", length = 1)
    private String twoBytesRight;

    @Column(name = "IO_STATUS_0403")
    private Integer ioStatus0403;

    @Column(name = "APPL_RESULT")
    private Integer applResult;

    @Column(name = "END_OF_FILE", length = 1)
    private String endOfFile;

    @Column(name = "ABCODE")
    private Integer abcode;

    @Column(name = "TIMING")
    private Integer timing;

}