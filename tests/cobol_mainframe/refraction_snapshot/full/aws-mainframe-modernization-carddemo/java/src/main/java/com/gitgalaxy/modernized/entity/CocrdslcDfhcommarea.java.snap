package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "DFHCOMMAREA")
public class CocrdslcDfhcommarea {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "WS_RESP_CD")
    private Integer wsRespCd;

    @Column(name = "WS_REAS_CD")
    private Integer wsReasCd;

    @Column(name = "WS_TRANID")
    private String wsTranid;

    @Column(name = "CARD_EXPIRAION_DATE_X")
    private String cardExpiraionDateX;

    @Column(name = "CARD_EXPIRY_YEAR")
    private String cardExpiryYear;

    @Column(name = "CARD_EXPIRY_MONTH")
    private String cardExpiryMonth;

    @Column(name = "CARD_EXPIRY_DAY")
    private String cardExpiryDay;

    @Column(name = "WS_CARD_RID_CARDNUM")
    private String wsCardRidCardnum;

    @Column(name = "WS_CARD_RID_ACCT_ID")
    private BigDecimal wsCardRidAcctId;

    @Column(name = "ERROR_OPNAME")
    private String errorOpname;

    @Column(name = "ERROR_FILE")
    private String errorFile;

    @Column(name = "ERROR_RESP")
    private String errorResp;

    @Column(name = "ERROR_RESP2")
    private String errorResp2;

    @Column(name = "WS_LONG_MSG")
    private String wsLongMsg;

    @Column(name = "WS_INFO_MSG")
    private String wsInfoMsg;

    @Column(name = "WS_RETURN_MSG")
    private String wsReturnMsg;

    @Column(name = "LIT_THISPGM")
    private String litThispgm;

    @Column(name = "LIT_THISTRANID")
    private String litThistranid;

    @Column(name = "LIT_THISMAPSET")
    private String litThismapset;

    @Column(name = "LIT_THISMAP")
    private String litThismap;

    @Column(name = "LIT_CCLISTPGM")
    private String litCclistpgm;

    @Column(name = "LIT_CCLISTMAPSET")
    private String litCclistmapset;

    @Column(name = "LIT_MENUPGM")
    private String litMenupgm;

    @Column(name = "LIT_MENUTRANID")
    private String litMenutranid;

    @Column(name = "LIT_CARDFILENAME")
    private String litCardfilename;

    @Column(name = "LIT_CARDFILENAME_ACCT_PATH")
    private String litCardfilenameAcctPath;

    @Column(name = "CA_FROM_PROGRAM")
    private String caFromProgram;

    @Column(name = "CA_FROM_TRANID")
    private String caFromTranid;

    @Column(name = "WS_COMMAREA")
    private String wsCommarea;

}