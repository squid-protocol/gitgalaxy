    @Column(name = "WS_CICS_RESP1_CD_D")
    private Integer wsCicsResp1CdD;

    @Column(name = "WS_CICS_RESP2_CD_D")
    private Integer wsCicsResp2CdD;

    @Column(name = "WS_ABS_TIME")
    private Integer wsAbsTime;

    @Column(name = "WS_MMDDYYYY")
    private String wsMmddyyyy;

    @Column(name = "WS_TIME")
    private String wsTime;

    @Column(name = "MQ_QUEUE")
    private String mqQueue;

    @Column(name = "MQ_QUEUE_REPLY")
    private String mqQueueReply;

    @Column(name = "MQ_HCONN")
    private Integer mqHconn;

    @Column(name = "MQ_CONDITION_CODE")
    private Integer mqConditionCode;

    @Column(name = "MQ_REASON_CODE")
    private Integer mqReasonCode;

    @Column(name = "MQ_HOBJ")
    private Integer mqHobj;

    @Column(name = "MQ_OPTIONS")
    private Integer mqOptions;

    @Column(name = "MQ_BUFFER_LENGTH")
    private Integer mqBufferLength;

    @Column(name = "MQ_BUFFER")
    private String mqBuffer;

    @Column(name = "MQ_DATA_LENGTH")
    private Integer mqDataLength;

    @Column(name = "MQ_CORRELID")
    private String mqCorrelid;

    @Column(name = "MQ_MSG_ID")
    private String mqMsgId;

    @Column(name = "MQ_MSG_COUNT")
    private Integer mqMsgCount;

    @Column(name = "SAVE_CORELID")
    private String saveCorelid;

    @Column(name = "SAVE_MSGID")
    private String saveMsgid;

    @Column(name = "SAVE_REPLY2Q")
    private String saveReply2Q;

    @Column(name = "MQ_ERROR_PARA")
    private String mqErrorPara;

    @Column(name = "MQ_APPL_RETURN_MESSAGE")
    private String mqApplReturnMessage;

    @Column(name = "MQ_APPL_CONDITION_CODE")
    private Integer mqApplConditionCode;

    @Column(name = "MQ_APPL_REASON_CODE")
