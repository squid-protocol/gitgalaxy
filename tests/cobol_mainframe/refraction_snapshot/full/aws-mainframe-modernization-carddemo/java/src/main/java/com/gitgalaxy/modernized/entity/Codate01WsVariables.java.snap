    @Column(name = "INPUT_QUEUE_NAME")
    private String inputQueueName;

    @Column(name = "REPLY_QUEUE_NAME")
    private String replyQueueName;

    @Column(name = "ERROR_QUEUE_NAME")
    private String errorQueueName;

    @Column(name = "INPUT_QUEUE_HANDLE")
    private Integer inputQueueHandle;

    @Column(name = "OUTPUT_QUEUE_HANDLE")
    private Integer outputQueueHandle;

    @Column(name = "ERROR_QUEUE_HANDLE")
    private Integer errorQueueHandle;

    @Column(name = "QMGR_HANDLE_CONN")
    private Integer qmgrHandleConn;

    @Column(name = "QUEUE_MESSAGE")
    private String queueMessage;

    @Column(name = "REQUEST_MESSAGE")
    private String requestMessage;

    @Column(name = "REPLY_MESSAGE")
    private String replyMessage;

    @Column(name = "ERROR_MESSAGE")
