package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "DFHCOMMAREA")
public class Cotrn00cDfhcommarea {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "WS_PGMNAME")
    private String wsPgmname;

    @Column(name = "WS_TRANID")
    private String wsTranid;

    @Column(name = "WS_MESSAGE")
    private String wsMessage;

    @Column(name = "WS_TRANSACT_FILE")
    private String wsTransactFile;

    @Column(name = "WS_ERR_FLG")
    private String wsErrFlg;

    @Column(name = "WS_RESP_CD")
    private Integer wsRespCd;

    @Column(name = "WS_REAS_CD")
    private Integer wsReasCd;

    @Column(name = "WS_IDX")
    private Integer wsIdx;

    @Column(name = "WS_TRAN_DATE")
    private String wsTranDate;

    @Column(name = "CDEMO_CT00_TRNID_FIRST")
    private String cdemoCt00TrnidFirst;

    @Column(name = "CDEMO_CT00_TRNID_LAST")
    private String cdemoCt00TrnidLast;

    @Column(name = "CDEMO_CT00_PAGE_NUM")
    private BigDecimal cdemoCt00PageNum;

    @Column(name = "CDEMO_CT00_NEXT_PAGE_FLG")
    private String cdemoCt00NextPageFlg;

    @Column(name = "CDEMO_CT00_TRN_SEL_FLG")
    private String cdemoCt00TrnSelFlg;

    @Column(name = "CDEMO_CT00_TRN_SELECTED")
    private String cdemoCt00TrnSelected;

}