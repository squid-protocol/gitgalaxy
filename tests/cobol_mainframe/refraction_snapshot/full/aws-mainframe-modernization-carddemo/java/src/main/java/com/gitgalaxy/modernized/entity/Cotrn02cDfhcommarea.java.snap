package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "DFHCOMMAREA")
public class Cotrn02cDfhcommarea {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "WS_PGMNAME")
    private String wsPgmname;

    @Column(name = "WS_TRANID")
    private String wsTranid;

    @Column(name = "WS_MESSAGE")
    private String wsMessage;

    @Column(name = "WS_TRANSACT_FILE")
    private String wsTransactFile;

    @Column(name = "WS_CCXREF_FILE")
    private String wsCcxrefFile;

    @Column(name = "WS_CXACAIX_FILE")
    private String wsCxacaixFile;

    @Column(name = "WS_ERR_FLG")
    private String wsErrFlg;

    @Column(name = "WS_RESP_CD")
    private Integer wsRespCd;

    @Column(name = "WS_REAS_CD")
    private Integer wsReasCd;

    @Column(name = "WS_ACCT_ID_N")
    private Integer wsAcctIdN;

    @Column(name = "WS_CARD_NUM_N")
    private Integer wsCardNumN;

    @Column(name = "WS_TRAN_ID_N")
    private Integer wsTranIdN;

    @Column(name = "WS_TRAN_AMT_N")
    private BigDecimal wsTranAmtN;

    @Column(name = "WS_DATE_FORMAT")
    private String wsDateFormat;

    @Column(name = "CSUTLDTC_DATE")
    private String csutldtcDate;

    @Column(name = "CSUTLDTC_DATE_FORMAT")
    private String csutldtcDateFormat;

    @Column(name = "CSUTLDTC_RESULT_SEV_CD")
    private String csutldtcResultSevCd;

    @Column(name = "CSUTLDTC_RESULT_MSG_NUM")
    private String csutldtcResultMsgNum;

    @Column(name = "CSUTLDTC_RESULT_MSG")
    private String csutldtcResultMsg;

    @Column(name = "CDEMO_CT02_TRNID_FIRST")
    private String cdemoCt02TrnidFirst;

    @Column(name = "CDEMO_CT02_TRNID_LAST")
    private String cdemoCt02TrnidLast;

    @Column(name = "CDEMO_CT02_PAGE_NUM")
    private BigDecimal cdemoCt02PageNum;

    @Column(name = "CDEMO_CT02_NEXT_PAGE_FLG")
    private String cdemoCt02NextPageFlg;

    @Column(name = "CDEMO_CT02_TRN_SEL_FLG")
    private String cdemoCt02TrnSelFlg;

    @Column(name = "CDEMO_CT02_TRN_SELECTED")
    private String cdemoCt02TrnSelected;

}