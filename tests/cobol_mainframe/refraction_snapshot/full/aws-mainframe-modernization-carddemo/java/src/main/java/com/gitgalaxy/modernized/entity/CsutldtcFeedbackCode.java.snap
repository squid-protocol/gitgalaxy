package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "FEEDBACK_CODE")
public class CsutldtcFeedbackCode {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "VSTRING_LENGTH")
    private Integer vstringLength;

    @Column(name = "VSTRING_CHAR")
    private String vstringChar;

    @Column(name = "OUTPUT_LILLIAN")
    private Integer outputLillian;

    @Column(name = "WS_SEVERITY")
    private String wsSeverity;

    @Column(name = "WS_MSG_NO")
    private String wsMsgNo;

    @Column(name = "WS_RESULT")
    private String wsResult;

    @Column(name = "WS_DATE")
    private String wsDate;

    @Column(name = "WS_DATE_FMT")
    private String wsDateFmt;

    @Column(name = "SEVERITY")
    private Integer severity;

    @Column(name = "MSG_NO")
    private Integer msgNo;

    @Column(name = "CLASS_CODE")
    private Integer classCode;

    @Column(name = "CAUSE_CODE")
    private Integer causeCode;

    @Column(name = "CASE_SEV_CTL")
    private String caseSevCtl;

    @Column(name = "FACILITY_ID")
    private String facilityId;

    @Column(name = "LS_DATE")
    private String lsDate;

    @Column(name = "LS_DATE_FORMAT")
    private String lsDateFormat;

    @Column(name = "LS_RESULT")
    private String lsResult;

}