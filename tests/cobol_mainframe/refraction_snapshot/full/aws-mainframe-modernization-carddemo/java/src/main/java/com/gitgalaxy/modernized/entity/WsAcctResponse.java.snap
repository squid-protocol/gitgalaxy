package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "WS_ACCT_RESPONSE")
public class WsAcctResponse {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "LIT_ACCTFILENAME")
    private String litAcctfilename;

    @Column(name = "WS_RESP_CD")
    private Integer wsRespCd;

    @Column(name = "WS_REAS_CD")
    private Integer wsReasCd;

    @Column(name = "WS_CARD_RID_ACCT_ID")
    private BigDecimal wsCardRidAcctId;

    @Column(name = "WS_ACCT_ID")
    private Integer wsAcctId;

    @Column(name = "WS_ACCT_ACTIVE_STATUS")
    private String wsAcctActiveStatus;

    @Column(name = "WS_ACCT_CURR_BAL")
    private BigDecimal wsAcctCurrBal;

    @Column(name = "WS_ACCT_CREDIT_LIMIT")
    private BigDecimal wsAcctCreditLimit;

    @Column(name = "WS_ACCT_CASH_CREDIT_LIMIT")
    private BigDecimal wsAcctCashCreditLimit;

    @Column(name = "WS_ACCT_OPEN_DATE")
    private String wsAcctOpenDate;

    @Column(name = "WS_ACCT_EXPIRAION_DATE")
    private String wsAcctExpiraionDate;

    @Column(name = "WS_ACCT_REISSUE_DATE")
    private String wsAcctReissueDate;

    @Column(name = "WS_ACCT_CURR_CYC_CREDIT")
    private BigDecimal wsAcctCurrCycCredit;

    @Column(name = "WS_ACCT_CURR_CYC_DEBIT")
    private BigDecimal wsAcctCurrCycDebit;

    @Column(name = "WS_ACCT_GROUP_ID")
    private String wsAcctGroupId;

}