package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "WS_EXPORT_STATISTICS")
public class WsExportStatistics {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "EXPORT_OUTPUT_RECORD")
    private String exportOutputRecord;

    @Column(name = "WS_CUSTOMER_STATUS")
    private String wsCustomerStatus;

    @Column(name = "WS_ACCOUNT_STATUS")
    private String wsAccountStatus;

    @Column(name = "WS_XREF_STATUS")
    private String wsXrefStatus;

    @Column(name = "WS_TRANSACTION_STATUS")
    private String wsTransactionStatus;

    @Column(name = "WS_CARD_STATUS")
    private String wsCardStatus;

    @Column(name = "WS_EXPORT_STATUS")
    private String wsExportStatus;

    @Column(name = "WS_EXPORT_DATE")
    private String wsExportDate;

    @Column(name = "WS_EXPORT_TIME")
    private String wsExportTime;

    @Column(name = "WS_FORMATTED_TIMESTAMP")
    private String wsFormattedTimestamp;

    @Column(name = "WS_SEQUENCE_COUNTER")
    private Integer wsSequenceCounter;

    @Column(name = "WS_CURR_YEAR")
    private BigDecimal wsCurrYear;

    @Column(name = "WS_CURR_MONTH")
    private BigDecimal wsCurrMonth;

    @Column(name = "WS_CURR_DAY")
    private BigDecimal wsCurrDay;

    @Column(name = "WS_CURR_HOUR")
    private BigDecimal wsCurrHour;

    @Column(name = "WS_CURR_MINUTE")
    private BigDecimal wsCurrMinute;

    @Column(name = "WS_CURR_SECOND")
    private BigDecimal wsCurrSecond;

    @Column(name = "WS_CURR_HUNDREDTH")
    private BigDecimal wsCurrHundredth;

    @Column(name = "WS_CUSTOMER_RECORDS_EXPORTED")
    private Integer wsCustomerRecordsExported;

    @Column(name = "WS_ACCOUNT_RECORDS_EXPORTED")
    private Integer wsAccountRecordsExported;

    @Column(name = "WS_XREF_RECORDS_EXPORTED")
    private Integer wsXrefRecordsExported;

    @Column(name = "WS_TRAN_RECORDS_EXPORTED")
    private Integer wsTranRecordsExported;

    @Column(name = "WS_CARD_RECORDS_EXPORTED")
    private Integer wsCardRecordsExported;

    @Column(name = "WS_TOTAL_RECORDS_EXPORTED")
    private Integer wsTotalRecordsExported;

}