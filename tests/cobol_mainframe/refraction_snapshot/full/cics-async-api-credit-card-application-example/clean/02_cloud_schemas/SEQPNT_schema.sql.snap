CREATE TABLE PROG_NAMES (
    CUST_NO_IN                     VARCHAR(4),
    CREDIT_CHECK_RESULT            VARCHAR(3),
    CUSTOMER_NAME                  VARCHAR(80),
    CUSTOMER_ADDRESS               VARCHAR(80),
    CUSTOMER_POSTCODE              VARCHAR(8),
    CUSTOMER_IMPORTANCE            VARCHAR(8),
    APPLICATION_RESULT             VARCHAR(7),
    APPLICATION_SUCCESS            VARCHAR(7),
    APPLICATION_FAILED             VARCHAR(7),
    TRANID                         VARCHAR(4),
    INPUTACCNUM                    VARCHAR(4),
    READ_INPUT_LENGTH              SMALLINT,
    PARENT_PROGRAM                 VARCHAR(8),
    ACCOUNT_NUM                    VARCHAR(4),
    TRANSACTION_1                  VARCHAR(4),
    TRAN1_STATUS                   VARCHAR(1),
    TRANSACTION_2                  VARCHAR(4),
    TRAN2_STATUS                   VARCHAR(1),
    TRANSACTION_3                  VARCHAR(4),
    TRAN3_STATUS                   VARCHAR(1),
    TRANSACTION_4                  VARCHAR(4),
    TRAN4_STATUS                   VARCHAR(1),
    TRANSACTION_5                  VARCHAR(4),
    TRAN5_STATUS                   VARCHAR(1),
    RESULT_TEXT                    VARCHAR(7),
    IS_TERMINAL_BASED              VARCHAR(1),
    START_CODE                     VARCHAR(2),
    INPUT_CONTAINER                VARCHAR(16),
    CRDTCHK_CONTAINER              VARCHAR(16),
    UPDCSDB_CONTAINER              VARCHAR(16),
    GETNAME_CONTAINER              VARCHAR(16),
    GETADDR_CONTAINER              VARCHAR(16),
    GETPOST_CONTAINER              VARCHAR(16),
    CSSTATUS_CONTAINER             VARCHAR(16),
    MYCHANNEL                      VARCHAR(16),
    CREDIT_CHECK                   VARCHAR(8),
    DB_CACHE                       VARCHAR(8),
    GET_NAME                       VARCHAR(8),
    GET_ADDR                       VARCHAR(8),
    CSSTATUS                       VARCHAR(8),
    COMMAND_RESP                   INTEGER,
    COMMAND_RESP2                  INTEGER
);