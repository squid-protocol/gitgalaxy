CREATE TABLE DFHCOMMAREA (
    REQUIRED_SORT_CODE             INTEGER,
    SQLCODE_DISPLAY                INTEGER,
    WS_ACCOUNT_RANGE_TOP           VARCHAR(1),
    WS_ACCOUNT_RANGE_MIDDLE        VARCHAR(1),
    WS_ACCOUNT_RANGE_BOTTOM        VARCHAR(1),
    HV_NUMBER_OF_ACCOUNTS          INTEGER,
    HV_ACCOUNT_SORTCODE            VARCHAR(6),
    WS_U_TIME                      BIGINT -- Legacy: COMP-3 (Packed Decimal),
    WS_ORIG_DATE                   VARCHAR(10),
    WS_TIME_NOW                    INTEGER,
    WS_TIME_NOW_GRP_HH             SMALLINT,
    WS_TIME_NOW_GRP_MM             SMALLINT,
    WS_TIME_NOW_GRP_SS             SMALLINT
);