    @Column(name = "WS_CICS_RESP2")
    private Integer wsCicsResp2;

    @Column(name = "WS_CICS_FAIL_MSG")
    private String wsCicsFailMsg;

    @Column(name = "WS_CICS_RESP_DISP")
    private Integer wsCicsRespDisp;

    @Column(name = "WS_CICS_RESP2_DISP")
    private Integer wsCicsResp2Disp;

    @Column(name = "VALID_DATA_SW")
    private String validDataSw;

    @Column(name = "END_OF_SESSION_MESSAGE")
    private String endOfSessionMessage;

    @Column(name = "WS_AVAIL_BAL_9")
    private BigDecimal wsAvailBal9;

    @Column(name = "WS_AVAIL_BAL_X_PND")
    private String wsAvailBalXPnd;

    @Column(name = "WS_AVAIL_BAL_X_PNCE")
    private String wsAvailBalXPnce;

    @Column(name = "WS_ACT_BAL_9")
    private BigDecimal wsActBal9;

    @Column(name = "WS_ACT_BAL_X_PND")
    private String wsActBalXPnd;

    @Column(name = "WS_ACT_BAL_X_PNCE")
    private String wsActBalXPnce;

    @Column(name = "INQACCCU_PROGRAM")
