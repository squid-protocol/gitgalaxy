package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "ABNDINFO_REC")
public class BnkmenuAbndinfoRec {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "WS_CICS_RESP")
    private Integer wsCicsResp;

    @Column(name = "WS_CICS_RESP2")
    private Integer wsCicsResp2;

    @Column(name = "WS_CICS_FAIL_MSG", length = 70)
    private String wsCicsFailMsg;

    @Column(name = "WS_CICS_RESP_DISP")
    private Integer wsCicsRespDisp;

    @Column(name = "WS_CICS_RESP2_DISP")
    private Integer wsCicsResp2Disp;

    @Column(name = "VALID_DATA_SW", length = 1)
    private String validDataSw;

    @Column(name = "END_OF_SESSION_MESSAGE", length = 13)
    private String endOfSessionMessage;

    @Column(name = "COMMUNICATION_AREA", length = 1)
    private String communicationArea;

    @Column(name = "WS_U_TIME")
    private Integer wsUTime;

    @Column(name = "WS_ORIG_DATE", length = 10)
    private String wsOrigDate;

    @Column(name = "WS_TIME_NOW")
    private Integer wsTimeNow;

    @Column(name = "WS_TIME_NOW_GRP_HH")
    private Integer wsTimeNowGrpHh;

    @Column(name = "WS_TIME_NOW_GRP_MM")
    private Integer wsTimeNowGrpMm;

    @Column(name = "WS_TIME_NOW_GRP_SS")
    private Integer wsTimeNowGrpSs;

    @Column(name = "WS_ABEND_PGM", length = 8)
    private String wsAbendPgm;

}