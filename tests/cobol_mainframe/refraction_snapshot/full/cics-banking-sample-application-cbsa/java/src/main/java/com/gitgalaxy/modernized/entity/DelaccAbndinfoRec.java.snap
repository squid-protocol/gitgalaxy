package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "ABNDINFO_REC")
public class DelaccAbndinfoRec {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "HV_ACCOUNT_EYECATCHER", length = 4)
    private String hvAccountEyecatcher;

    @Column(name = "HV_ACCOUNT_CUST_NO", length = 10)
    private String hvAccountCustNo;

    @Column(name = "HV_ACCOUNT_SORTCODE", length = 6)
    private String hvAccountSortcode;

    @Column(name = "HV_ACCOUNT_ACC_NO", length = 8)
    private String hvAccountAccNo;

    @Column(name = "HV_ACCOUNT_ACC_TYPE", length = 8)
    private String hvAccountAccType;

    @Column(name = "HV_ACCOUNT_INT_RATE", precision = 6, scale = 2)
    private BigDecimal hvAccountIntRate;

    @Column(name = "HV_ACCOUNT_OPENED", length = 10)
    private String hvAccountOpened;

    @Column(name = "HV_ACCOUNT_OVERDRAFT_LIM")
    private Integer hvAccountOverdraftLim;

    @Column(name = "HV_ACCOUNT_LAST_STMT", length = 10)
    private String hvAccountLastStmt;

    @Column(name = "HV_ACCOUNT_NEXT_STMT", length = 10)
    private String hvAccountNextStmt;

    @Column(name = "HV_ACCOUNT_AVAIL_BAL", precision = 12, scale = 2)
    private BigDecimal hvAccountAvailBal;

    @Column(name = "HV_ACCOUNT_ACTUAL_BAL", precision = 12, scale = 2)
    private BigDecimal hvAccountActualBal;

    @Column(name = "HV_PROCTRAN_EYECATCHER", length = 4)
    private String hvProctranEyecatcher;

    @Column(name = "HV_PROCTRAN_SORT_CODE", length = 6)
    private String hvProctranSortCode;

    @Column(name = "HV_PROCTRAN_ACC_NUMBER", length = 8)
    private String hvProctranAccNumber;

    @Column(name = "HV_PROCTRAN_DATE", length = 10)
    private String hvProctranDate;

    @Column(name = "HV_PROCTRAN_TIME", length = 6)
    private String hvProctranTime;

    @Column(name = "HV_PROCTRAN_REF", length = 12)
    private String hvProctranRef;

    @Column(name = "HV_PROCTRAN_TYPE", length = 3)
    private String hvProctranType;

    @Column(name = "HV_PROCTRAN_DESC", length = 40)
    private String hvProctranDesc;

    @Column(name = "HV_PROCTRAN_AMOUNT", precision = 12, scale = 2)
    private BigDecimal hvProctranAmount;

    @Column(name = "SQLCODE_DISPLAY")
    private Integer sqlcodeDisplay;

    @Column(name = "ACCOUNT_ACT_BAL_STORE", precision = 12, scale = 2)
    private BigDecimal accountActBalStore;

    @Column(name = "RETURNED_SORT_CODE")
    private Integer returnedSortCode;

    @Column(name = "RETURNED_NUMBER")
    private Integer returnedNumber;

    @Column(name = "DB2_DATE_REF_YR")
    private Integer db2DateRefYr;

    @Column(name = "DB2_DATE_REF_MNTH")
    private Integer db2DateRefMnth;

    @Column(name = "DB2_DATE_REF_DAY")
    private Integer db2DateRefDay;

    @Column(name = "WS_EIBTASKN12")
    private Integer wsEibtaskn12;

    @Column(name = "REQUIRED_SORT_CODE")
    private Integer requiredSortCode;

    @Column(name = "WS_U_TIME")
    private Integer wsUTime;

    @Column(name = "WS_ORIG_DATE", length = 10)
    private String wsOrigDate;

    @Column(name = "WS_TIME_NOW")
    private Integer wsTimeNow;

    @Column(name = "WS_TIME_NOW_GRP_HH")
    private Integer wsTimeNowGrpHh;

    @Column(name = "WS_TIME_NOW_GRP_MM")
    private Integer wsTimeNowGrpMm;

    @Column(name = "WS_TIME_NOW_GRP_SS")
    private Integer wsTimeNowGrpSs;

    @Column(name = "WS_ABEND_PGM", length = 8)
    private String wsAbendPgm;

}