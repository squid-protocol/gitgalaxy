    EM_SQLREQ                      VARCHAR(16),
    EM_SQLRC                       INTEGER,
    CA_DATA                        VARCHAR(90),
    WS_CA_HEADERTRAILER_LEN        SMALLINT,
    WS_REQUIRED_CA_LEN             SMALLINT,
    DB2_CUSTOMERNUMBER_INT         INTEGER
