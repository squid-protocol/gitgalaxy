    WRITE_MSG_POLNUM               BIGINT,
    PART_KEY_TYPE                  VARCHAR(1),
    PART_KEY_NUM                   BIGINT,
    CA_POLICY_TYPE                 VARCHAR(1),
    F64                            SMALLINT,
    F11                            SMALLINT,
