    WRITE_MSG_MSG                  VARCHAR(90),
    WRITE_MSG_REST                 VARCHAR(83),
    STSQ_NAME                      VARCHAR(8),
    STSQ_EXT                       VARCHAR(4),
    TEMPO                          VARCHAR(90),
    STDQ_NAME                      VARCHAR(4),
    COMMA_DATA                     VARCHAR(90)
);