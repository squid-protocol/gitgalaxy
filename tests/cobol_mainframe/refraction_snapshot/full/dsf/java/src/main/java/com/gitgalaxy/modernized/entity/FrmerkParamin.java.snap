package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "PARAMIN")
public class FrmerkParamin {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "INN_AAR")
    private String innAar;

    @Column(name = "TRKNR")
    private Integer trknr;

    @Column(name = "NAVN")
    private String navn;

    @Column(name = "GATE1")
    private String gate1;

    @Column(name = "GATE2")
    private String gate2;

    @Column(name = "POSTSTED")
    private String poststed;

    @Column(name = "UTPOSTEN")
    private String utposten;

    @Column(name = "TELLER")
    private Integer teller;

    @Column(name = "NAVN1")
    private String navn1;

    @Column(name = "NAVN2")
    private String navn2;

    @Column(name = "NAVN22")
    private String navn22;

    @Column(name = "NAVN3")
    private String navn3;

    @Column(name = "TRKNR_L")
    private Integer trknrL;

    @Column(name = "AARSTALL")
    private String aarstall;

    @Column(name = "INNAAR")
    private String innaar;

    @Column(name = "BLK")
    private String blk;

}