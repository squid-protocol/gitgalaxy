package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "PARAMIN")
public class FrmerkParamin {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "INN_AAR", length = 80)
    private String innAar;

    @Column(name = "TRKNR")
    private Integer trknr;

    @Column(name = "NAVN", length = 26)
    private String navn;

    @Column(name = "GATE1", length = 25)
    private String gate1;

    @Column(name = "GATE2", length = 25)
    private String gate2;

    @Column(name = "POSTSTED", length = 21)
    private String poststed;

    @Column(name = "UTPOSTEN", length = 133)
    private String utposten;

    @Column(name = "TELLER")
    private Integer teller;

    @Column(name = "NAVN1", length = 33)
    private String navn1;

    @Column(name = "NAVN2", length = 33)
    private String navn2;

    @Column(name = "NAVN22", length = 33)
    private String navn22;

    @Column(name = "NAVN3", length = 33)
    private String navn3;

    @Column(name = "TRKNR_L")
    private Integer trknrL;

    @Column(name = "AARSTALL", length = 4)
    private String aarstall;

    @Column(name = "INNAAR", length = 4)
    private String innaar;

    @Column(name = "BLK", length = 133)
    private String blk;

}