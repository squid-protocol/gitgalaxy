package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "PARAMIN")
public class FrredigParamin {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "INN_AAR", length = 80)
    private String innAar;

    @Column(name = "TRKNR")
    private Integer trknr;

    @Column(name = "AAR")
    private Integer aar;

    @Column(name = "MND")
    private Integer mnd;

    @Column(name = "DAG")
    private Integer dag;

    @Column(name = "FNR1")
    private Integer fnr1;

    @Column(name = "FNR2")
    private Integer fnr2;

    @Column(name = "NAVN", length = 26)
    private String navn;

    @Column(name = "GATE", length = 50)
    private String gate;

    @Column(name = "POSTSTED", length = 21)
    private String poststed;

    @Column(name = "UTPOSTEN", length = 133)
    private String utposten;

    @Column(name = "TELLER")
    private Integer teller;

    @Column(name = "DAGO")
    private Integer dago;

    @Column(name = "MNDO")
    private Integer mndo;

    @Column(name = "AARO")
    private Integer aaro;

    @Column(name = "FNR1O")
    private Integer fnr1o;

    @Column(name = "FNR2O")
    private Integer fnr2o;

    @Column(name = "NAVNO", length = 26)
    private String navno;

    @Column(name = "GATEO", length = 50)
    private String gateo;

    @Column(name = "POSTSTEDO", length = 21)
    private String poststedo;

    @Column(name = "TRKNR_L")
    private Integer trknrL;

    @Column(name = "AARSTALL", length = 4)
    private String aarstall;

    @Column(name = "INNAAR", length = 4)
    private String innaar;

    @Column(name = "BLK", length = 133)
    private String blk;

}