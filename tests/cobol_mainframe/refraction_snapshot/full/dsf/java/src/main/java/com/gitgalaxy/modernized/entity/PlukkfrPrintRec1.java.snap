package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "PRINT_REC1")
public class PlukkfrPrintRec1 {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "TRK_NR")
    private Integer trkNr;

    @Column(name = "INN_FNR")
    private Integer innFnr;

    @Column(name = "NAVN")
    private String navn;

    @Column(name = "INN_TRKNR")
    private Integer innTrknr;

    @Column(name = "ADDR")
    private String addr;

    @Column(name = "UT_TRKNR")
    private Integer utTrknr;

    @Column(name = "UT_FNR")
    private Integer utFnr;

    @Column(name = "UT_NAVN")
    private String utNavn;

    @Column(name = "UT_ADDR")
    private String utAddr;

    @Column(name = "TELLER1")
    private Integer teller1;

}