CREATE TABLE DFHCOMMAREA (
    WS_TRANSID                     VARCHAR(4),
    WS_TERMID                      VARCHAR(4),
    WS_TASKNUM                     INTEGER,
    WS_CALEN                       SMALLINT,
    HCIMDB01                       VARCHAR(8),
    WS_CA_HEADERTRAILER_LEN        SMALLINT,
    WS_REQUIRED_CA_LEN             SMALLINT,
    WS_COUNTER                     SMALLINT,
    HCAZERRS                       VARCHAR(8),
    WS_ABSTIME                     INTEGER,
    WS_TIME                        VARCHAR(8),
    WS_DATE                        VARCHAR(10),
    EM_DATE                        VARCHAR(8),
    EM_TIME                        VARCHAR(6),
    EM_PATNUM                      VARCHAR(10),
    EM_MEDNUM                      VARCHAR(10),
    EM_SQLREQ                      VARCHAR(16),
    EM_SQLRC                       INTEGER,
    CA_DATA                        VARCHAR(90),
    CA_RETURN_CODE                 SMALLINT,
    CA_PATIENT_ID                  BIGINT,
    CA_NUM_MEDICATIONS             SMALLINT -- Legacy: COMP-3 (Packed Decimal),
    CA_MEDICATION_ID               BIGINT,
    CA_DRUG_NAME                   VARCHAR(50),
    CA_STRENGTH                    VARCHAR(20),
    CA_AMOUNT                      SMALLINT,
    CA_ROUTE                       VARCHAR(20),
    CA_FREQUENCY                   VARCHAR(20),
    CA_IDENTIFIER                  VARCHAR(20),
    CA_TYPE                        VARCHAR(2)
);