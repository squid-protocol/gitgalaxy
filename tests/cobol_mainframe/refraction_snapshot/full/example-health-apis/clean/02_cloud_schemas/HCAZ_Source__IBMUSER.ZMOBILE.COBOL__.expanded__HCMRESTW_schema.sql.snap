CREATE TABLE WS_COMMAREA_LENGTHS (
    PATIENT_ID                     VARCHAR(10),
    MEDICATIONS2_NUM               INTEGER,
    MEDICATION_ID                  BIGINT,
    NAME                           VARCHAR(50),
    STRENGTH                       VARCHAR(20),
    AMOUNT                         SMALLINT,
    ROUTE                          VARCHAR(20),
    FREQUENCY                      VARCHAR(20),
    IDENTIFIER                     VARCHAR(20),
    BIOMED_TYPE                    VARCHAR(2),
    CA_REQUEST_ID                  VARCHAR(6),
    CA_RETURN_CODE                 SMALLINT,
    CA_PATIENT_ID                  BIGINT,
    CA_NUM_MEDICATIONS             SMALLINT -- Legacy: COMP-3 (Packed Decimal),
    CA_MEDICATION_ID               BIGINT,
    CA_DRUG_NAME                   VARCHAR(50),
    CA_STRENGTH                    VARCHAR(20),
    CA_AMOUNT                      SMALLINT,
    CA_ROUTE                       VARCHAR(20),
    CA_FREQUENCY                   VARCHAR(20),
    CA_IDENTIFIER                  VARCHAR(20),
    CA_TYPE                        VARCHAR(2),
    DEFAULT_CHANNEL                VARCHAR(16),
    WS_TSQ_NAME                    VARCHAR(8),
    WS_TSQ_LEN                     SMALLINT,
    WS_TSQ_DATA                    VARCHAR(200),
    WS_RETURN_RESPONSE             VARCHAR(100),
    WS_HTTP_METHOD                 VARCHAR(8),
    WS_RESID                       VARCHAR(100),
    WS_RESID2                      VARCHAR(100),
    WS_COUNTER                     SMALLINT,
    WS_FIELD1                      VARCHAR(10),
    WS_FIELD2                      VARCHAR(3),
    WS_FIELD3                      VARCHAR(3),
    WS_FIELD4                      VARCHAR(30),
    WS_FIELD5                      VARCHAR(30),
    RESP                           INTEGER,
    RESP2                          INTEGER,
    UNEXPECTED_RESP_ABCODE         VARCHAR(04),
    UNSUPPORTED_METHOD_ABCODE      VARCHAR(04),
    METHOD_GET                     VARCHAR(8),
    METHOD_PUT                     VARCHAR(8),
    METHOD_POST                    VARCHAR(8)
);