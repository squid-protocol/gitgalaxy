    PATH_NAME                      VARCHAR(400),
    PATH_NAME_LEN                  INTEGER,
    HTTP_STATUS_CODE               SMALLINT,
    HTTP_STATUS_LEN                INTEGER,
    HTTP_STATUS_TEXT               VARCHAR(100),
    METHOD_CDVA                    INTEGER,
    I                              SMALLINT,
    MEDIA_TYPE                     VARCHAR(56),
    INPUT_PARM1                    VARCHAR(80),
    INPUT_PARM2                    VARCHAR(80),
    TERM_LINES                     VARCHAR(80),
    CICS_MSG_TEXT                  VARCHAR(34),
