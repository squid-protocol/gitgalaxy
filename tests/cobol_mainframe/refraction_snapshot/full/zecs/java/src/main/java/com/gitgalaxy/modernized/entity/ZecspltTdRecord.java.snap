package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "TD_RECORD")
public class ZecspltTdRecord {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "EOF", length = 1)
    private String eof;

    @Column(name = "ZC", length = 2)
    private String zc;

    @Column(name = "URI_PREFIX", length = 4)
    private String uriPrefix;

    @Column(name = "URI_SUFFIX", length = 4)
    private String uriSuffix;

    @Column(name = "URI_TRAN", length = 4)
    private String uriTran;

    @Column(name = "ZX_SUFFIX", length = 2)
    private String zxSuffix;

    @Column(name = "CSSL", length = 4)
    private String cssl;

    @Column(name = "TD_LENGTH")
    private Integer tdLength;

    @Column(name = "TD_SUFFIX", length = 2)
    private String tdSuffix;

    @Column(name = "TD_TRAN", length = 4)
    private String tdTran;

    @Column(name = "TD_PATH", length = 80)
    private String tdPath;

    @Column(name = "URI_PATH", length = 256)
    private String uriPath;

}