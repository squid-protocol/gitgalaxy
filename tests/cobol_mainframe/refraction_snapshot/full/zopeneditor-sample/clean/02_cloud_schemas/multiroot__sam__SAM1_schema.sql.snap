CREATE TABLE RPT_STATS_CUST_DETAIL (
    REPORT_RECORD                  VARCHAR(132),
    CURRENT_YEAR                   SMALLINT,
    CURRENT_MONTH                  SMALLINT,
    CURRENT_DAY                    SMALLINT,
    CURRENT_HOUR                   SMALLINT,
    CURRENT_MINUTE                 SMALLINT,
    CURRENT_SECOND                 SMALLINT,
    WS_CUSTFILE_STATUS             VARCHAR(2),
    WS_CUSTOUT_STATUS              VARCHAR(2),
    WS_TRANFILE_STATUS             VARCHAR(2),
    WS_REPORT_STATUS               VARCHAR(2),
    WS_TRAN_EOF                    VARCHAR(1),
    WS_TRAN_OK                     VARCHAR(1),
    WS_CUST_FILE_EOF               VARCHAR(1),
    WS_TRAN_MSG                    VARCHAR(50),
    WS_PREV_TRAN_KEY               VARCHAR(13),
    SAM2                           VARCHAR(8),
    I                              INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_TRAN_RECS                  INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_TRAN_ERRORS                INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_ADD_REQUESTS               INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_ADD_PROCESSED              INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_UPDATE_REQUESTS            INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_UPDATE_PROCESSED           INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_DELETE_REQUESTS            INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_DELETE_PROCESSED           INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_CRUNCH_REQUESTS            INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_CRUNCH_PROCESSED           INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_PRE_CUSTOMERS              INTEGER -- Legacy: COMP-3 (Packed Decimal),
    NUM_POST_CUSTOMERS             INTEGER -- Legacy: COMP-3 (Packed Decimal),
    ERR_MSG_DATA1                  VARCHAR(35),
    ERR_MSG_DATA2                  VARCHAR(66),
    ERR_MSG_DATA3                  VARCHAR(80),
    RPT_MM                         SMALLINT,
    RPT_DD                         SMALLINT,
    RPT_YY                         SMALLINT,
    RPT_HH                         SMALLINT,
    RPT_MIN                        SMALLINT,
    RPT_SS                         SMALLINT,
    RPT_TRAN_MSG1                  VARCHAR(31),
    RPT_TRAN_RECORD                VARCHAR(80),
    RPT_CRUNCH_CUST                VARCHAR(14),
    RPT_CRUNCH_TOTAL               SMALLINT,
    RPT_CRUNCH_AVG                 SMALLINT,
    RPT_TRAN                       VARCHAR(10),
    RPT_NUM_TRANS                  SMALLINT,
    RPT_NUM_TRAN_PROC              SMALLINT,
    RPT_NUM_TRAN_ERR               SMALLINT,
    CUST_CNT_NAME                  VARCHAR(30),
    RPT_NUM_CUST                   SMALLINT
);