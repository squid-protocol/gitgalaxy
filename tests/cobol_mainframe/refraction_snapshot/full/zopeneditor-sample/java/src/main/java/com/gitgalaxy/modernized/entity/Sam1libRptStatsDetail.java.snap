package com.gitgalaxy.modernized.entity;

import lombok.Data;
import lombok.NoArgsConstructor;
import jakarta.persistence.*;
import java.math.BigDecimal;

@Data
@NoArgsConstructor
@Entity
@Table(name = "RPT_STATS_DETAIL")
public class Sam1libRptStatsDetail {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "sys_id")
    private Long sysId;

    @Column(name = "REPORT_RECORD")
    private String reportRecord;

    @Column(name = "WS_CUSTFILE_STATUS")
    private String wsCustfileStatus;

    @Column(name = "WS_CUSTOUT_STATUS")
    private String wsCustoutStatus;

    @Column(name = "WS_TRANFILE_STATUS")
    private String wsTranfileStatus;

    @Column(name = "WS_REPORT_STATUS")
    private String wsReportStatus;

    @Column(name = "WS_TRAN_EOF")
    private String wsTranEof;

    @Column(name = "WS_TRAN_OK")
    private String wsTranOk;

    @Column(name = "WS_CUST_FILE_EOF")
    private String wsCustFileEof;

    @Column(name = "WS_TRAN_MSG")
    private String wsTranMsg;

    @Column(name = "WS_PREV_TRAN_KEY")
    private String wsPrevTranKey;

    @Column(name = "SAM2")
    private String sam2;

    @Column(name = "I")
    private Integer i;

    @Column(name = "ERR_MSG_DATA1")
    private String errMsgData1;

    @Column(name = "ERR_MSG_DATA2")
    private String errMsgData2;

    @Column(name = "ERR_MSG_DATA3")
    private String errMsgData3;

    @Column(name = "RPT_MM")
    private BigDecimal rptMm;

    @Column(name = "RPT_DD")
    private BigDecimal rptDd;

    @Column(name = "RPT_YY")
    private BigDecimal rptYy;

    @Column(name = "RPT_HH")
    private BigDecimal rptHh;

    @Column(name = "RPT_MIN")
    private BigDecimal rptMin;

    @Column(name = "RPT_SS")
    private BigDecimal rptSs;

    @Column(name = "RPT_TRAN_MSG1")
    private String rptTranMsg1;

    @Column(name = "RPT_TRAN_RECORD")
    private String rptTranRecord;

    @Column(name = "RPT_TRAN")
    private String rptTran;

    @Column(name = "RPT_NUM_TRANS")
    private String rptNumTrans;

    @Column(name = "RPT_NUM_TRAN_PROC")
    private String rptNumTranProc;

    @Column(name = "RPT_NUM_TRAN_ERR")
    private String rptNumTranErr;

}