     },
     {
      "data": "DATE AGAIN",
      "format": "MQSTR",
      "msgtype": 1,
      "replytoq": "CARD.DEMO.REPLY.DATE"
     }
    ]
   },
   "why": "three requests, each replied to with its own MsgId and CorrelId, one SYNCPOINT after each"
