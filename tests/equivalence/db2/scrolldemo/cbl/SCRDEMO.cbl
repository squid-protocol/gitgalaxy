       IDENTIFICATION DIVISION.
       PROGRAM-ID. SCRDEMO.
      * #4269: FETCH orientations of a scroll cursor, insensitive: the
      * rows are fixed at OPEN and FETCH moves a position over them.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
           EXEC SQL DECLARE GGSCR.ITEM TABLE
               ( ID                 INTEGER NOT NULL
               ) END-EXEC.
       01  WS-ID                    PIC S9(9) COMP VALUE 0.
       01  WS-N                     PIC S9(9) COMP.
       01  WS-CODE                  PIC -(9)9.
       01  WS-SHOW                  PIC -(9)9.
       01  WS-TAG                   PIC X(14).
           EXEC SQL DECLARE SC1 INSENSITIVE SCROLL CURSOR FOR
               SELECT ID FROM GGSCR.ITEM ORDER BY ID
           END-EXEC.
           EXEC SQL DECLARE SC2 SCROLL CURSOR FOR
               SELECT ID FROM GGSCR.ITEM WHERE ID > 99 ORDER BY ID
           END-EXEC.
       PROCEDURE DIVISION.
       MAIN-PARA.
           EXEC SQL OPEN SC1 END-EXEC
           EXEC SQL FETCH SC1 INTO :WS-ID END-EXEC
           MOVE 'NEXT' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH LAST SC1 INTO :WS-ID END-EXEC
           MOVE 'LAST' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH PRIOR SC1 INTO :WS-ID END-EXEC
           MOVE 'PRIOR' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH FIRST FROM SC1 INTO :WS-ID END-EXEC
           MOVE 'FIRST' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH ABSOLUTE 3 SC1 INTO :WS-ID END-EXEC
           MOVE 'ABS 3' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH ABSOLUTE -2 SC1 INTO :WS-ID END-EXEC
           MOVE 'ABS -2' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH RELATIVE 1 SC1 INTO :WS-ID END-EXEC
           MOVE 'REL 1' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH RELATIVE 1 SC1 INTO :WS-ID END-EXEC
           MOVE 'REL 1 PAST' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH PRIOR SC1 INTO :WS-ID END-EXEC
           MOVE 'PRIOR OFF' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH CURRENT SC1 INTO :WS-ID END-EXEC
           MOVE 'CURRENT' TO WS-TAG
           PERFORM SHOW-PARA
           MOVE -3 TO WS-N
           EXEC SQL FETCH RELATIVE :WS-N SC1 INTO :WS-ID END-EXEC
           MOVE 'REL VAR -3' TO WS-TAG
           PERFORM SHOW-PARA
           MOVE 4 TO WS-N
           EXEC SQL FETCH ABSOLUTE :WS-N SC1 INTO :WS-ID END-EXEC
           MOVE 'ABS VAR 4' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH FIRST SC1 INTO :WS-ID END-EXEC
           MOVE 'FIRST' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH PRIOR SC1 INTO :WS-ID END-EXEC
           MOVE 'PRIOR BEFORE' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH NEXT SC1 INTO :WS-ID END-EXEC
           MOVE 'NEXT AFTER' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH ABSOLUTE 9 SC1 INTO :WS-ID END-EXEC
           MOVE 'ABS 9' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH PRIOR SC1 INTO :WS-ID END-EXEC
           MOVE 'PRIOR LAST' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH RELATIVE -9 SC1 INTO :WS-ID END-EXEC
           MOVE 'REL -9' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH SC1 INTO :WS-ID END-EXEC
           MOVE 'NEXT FIRST' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH ABSOLUTE 0 SC1 INTO :WS-ID END-EXEC
           MOVE 'ABS 0' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL CLOSE SC1 END-EXEC
           MOVE 'CLOSE' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH LAST SC1 INTO :WS-ID END-EXEC
           MOVE 'LAST CLOSED' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL OPEN SC2 END-EXEC
           EXEC SQL FETCH FIRST SC2 INTO :WS-ID END-EXEC
           MOVE 'EMPTY FIRST' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL FETCH LAST SC2 INTO :WS-ID END-EXEC
           MOVE 'EMPTY LAST' TO WS-TAG
           PERFORM SHOW-PARA
           EXEC SQL CLOSE SC2 END-EXEC
           STOP RUN.
       SHOW-PARA.
           MOVE SQLCODE TO WS-CODE
           MOVE WS-ID TO WS-SHOW
           DISPLAY WS-TAG WS-CODE WS-SHOW.
