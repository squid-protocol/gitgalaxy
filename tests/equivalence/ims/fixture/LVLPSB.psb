*  #4893 level fixture: PCB 1 may do everything (PROCOPT=A), PCB 2 only read (PROCOPT=G), one database.
LVLPCB1  PCB     TYPE=DB,DBDNAME=LVLDBD,PROCOPT=A,KEYLEN=10
         SENSEG  NAME=DEPT,PARENT=0
         SENSEG  NAME=EMP,PARENT=DEPT
         SENSEG  NAME=SKILL,PARENT=EMP
         SENSEG  NAME=PROJ,PARENT=DEPT
LVLPCB2  PCB     TYPE=DB,DBDNAME=LVLDBD,PROCOPT=G,KEYLEN=10
         SENSEG  NAME=DEPT,PARENT=0
         SENSEG  NAME=EMP,PARENT=DEPT
         SENSEG  NAME=SKILL,PARENT=EMP
         SENSEG  NAME=PROJ,PARENT=DEPT
         PSBGEN  LANG=COBOL,PSBNAME=LVLPSB,CMPAT=NO
         END
