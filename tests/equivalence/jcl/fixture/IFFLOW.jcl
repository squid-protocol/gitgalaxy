//*********************************************************************
//* #8413 tier 1: IF/THEN/ELSE/ENDIF step flow, written from IBM's
//* z/OS MVS JCL Reference (SA23-1385) before jcl_flow ran on it.
//* No program runs: scenarios.json gives each step's RC or abend.
//* Shapes follow the manual's own examples 5, 6 and 9.
//*********************************************************************
//NESTJOB  JOB (ACCT),'NESTED IF',CLASS=A,MSGCLASS=X
//N1       EXEC PGM=PGMA
// IF (N1.RC > 4) THEN
//N2       EXEC PGM=PGMB
//  IF (N2.RC = 0) THEN
//N3       EXEC PGM=PGMC
//  ELSE
//N4       EXEC PGM=PGMD
//  ENDIF
// ELSE
//N5       EXEC PGM=PGME
// ENDIF
//N6       EXEC PGM=PGMF
//*
//ABNJOB   JOB (ACCT),'NOT ABEND ABENDCC',CLASS=A,MSGCLASS=X
//A1       EXEC PGM=PGMA
// IF ¬ABEND THEN
//A2       EXEC PGM=PGMB
//A3       EXEC PGM=PGMC
// ELSE
//A4       EXEC PGM=PGMD
// ENDIF
// IF (A1.ABENDCC=U0012 | A2.ABENDCC=S0C4) THEN
//A5       EXEC PGM=PGME
// ELSE
//  IF ¬(RC > 8) THEN
//A6       EXEC PGM=PGMF
//  ELSE
//A7       EXEC PGM=PGMG
//  ENDIF
// ENDIF
//*
//NOTJOB   JOB (ACCT),'NOT OPERATOR',CLASS=A,MSGCLASS=X
//T1       EXEC PGM=PGMA
// IF ¬(T1.RC = 8 | T1.RC > 10) THEN
//T2       EXEC PGM=PGMB
// ENDIF
// IF (T1.RC ¬= 8 & T1.RC <= 10) THEN
//T3       EXEC PGM=PGMC
// ENDIF
// IF ¬T2.RUN THEN
//T4       EXEC PGM=PGMD
// ENDIF
//*
//PRC5JOB  JOB (ACCT),'IF AROUND PROC',CLASS=A,MSGCLASS=X
//PROC1    PROC
//PSTEPONE EXEC PGM=PGMA
//PSTEP11  EXEC PGM=PGMB
//PSTEP12  EXEC PGM=PGMC
//         PEND
//PROC2    PROC
//PSTEPTWO EXEC PGM=PGMD
//         PEND
//EXP1     EXEC PROC=PROC1
//EXP2     EXEC PROC=PROC2
//IFTEST3  IF (RC > 12) THEN
//STEP1BAD IF (EXP1.PSTEP11.RC > 12 | EXP1.PSTEP12.RC > 12) THEN
//STEP1ERR EXEC PGM=ERRTN
//         ELSE
//STEP2ERR EXEC PGM=ERRTN
//END1BAD  ENDIF
//         ELSE
//NOPROB   EXEC PGM=RUNOK
//ENDTEST3 ENDIF
//NEXTSTEP EXEC PGM=PGMN
//*
//PRC6JOB  JOB (ACCT),'IF ABENDCC PROC',CLASS=A,MSGCLASS=X
//PROC1    PROC
//PSTEPONE EXEC PGM=PGMA
//         PEND
//PROC2    PROC
//PSTEPTWO EXEC PGM=PGMD
//         PEND
//EXP1     EXEC PROC=PROC1
//EXP2     EXEC PROC=PROC2
//IFTEST4  IF (EXP1.PSTEPONE.RC > 4) THEN
//STEP1ERR EXEC PGM=PROG1
//         ELSE
//IFTEST5  IF (EXP2.PSTEPTWO.ABENDCC=U0012) THEN
//STEP2ERR EXEC PGM=PROG2
//         ELSE
//NOERR    EXEC PGM=PROG3
//ENDTEST5 ENDIF
//ENDTEST4 ENDIF
//*
//MIXJOB   JOB (ACCT),'IF PLUS COND',CLASS=A,MSGCLASS=X
//M1       EXEC PGM=PGMA
//M2       EXEC PGM=PGMB,COND=(4,LT,M1)
// IF (M1.RC < 8) THEN
//M3       EXEC PGM=PGMC,COND=(0,NE,M2)
// ENDIF
// IF (ABEND) THEN
//M4       EXEC PGM=PGMD,COND=EVEN
//M5       EXEC PGM=PGME,COND=ONLY
// ENDIF
