{
  "case": "carddemo-nightly",
  "corpus": "aws-mainframe-modernization-carddemo",
  "jcl_dir": "app/jcl",
  "proc_dir": "app/proc",
  "jobs": {
    "POSTTRAN": "POSTTRAN.jcl",
    "INTCALC": "INTCALC.jcl",
    "TRANBKP": "TRANBKP.jcl",
    "COMBTRAN": "COMBTRAN.jcl",
    "CREASTMT": "CREASTMT.JCL",
    "TRANIDX": "TRANIDX.jcl"
  },
  "forge_utility_jobs": ["TRANBKP", "COMBTRAN", "TRANIDX"],
  "datasets": {
    "AWS.M2.CARDDEMO.TRANSACT.VSAM.KSDS": {
      "job": "CREASTMT", "lrecl": 350, "recfm": "FB",
      "seed": "tests/equivalence/carddemo-sort-creastmt/sortin.txt",
      "source": "RECORDSIZE(350 350) in app/jcl/TRANFILE.jcl; the seed is the job case's 100 SORTIN records (newline-delimited, 350 bytes each)"
    }
  },
  "unmodelled": {
    "CREASTMT": ["DELDEF01", "STEP030"]
  },
  "steps": [
    {"case": "carddemo-posttran", "job": "POSTTRAN", "jcl_steps": ["STEP15"]},
    {"case": "carddemo-intcalc", "job": "INTCALC", "jcl_steps": ["STEP15"]},
    {"case": "tranbkp-idcams", "job": "TRANBKP", "jcl_steps": ["STEP05R.PRC001", "STEP05", "STEP10"]},
    {"case": "carddemo-sort-combtran", "job": "COMBTRAN", "jcl_steps": ["STEP05R"],
     "dd_alias": {"SORTIN1": "SORTIN", "SORTIN2": "SORTIN#2"}},
    {"case": "combtran-step10-idcams", "job": "COMBTRAN", "jcl_steps": ["STEP10"]},
    {"case": "carddemo-sort-creastmt", "job": "CREASTMT", "jcl_steps": ["STEP010"]},
    {"case": "creastmt-step020", "job": "CREASTMT", "jcl_steps": ["STEP020"]},
    {"case": "carddemo-cbstm03a", "job": "CREASTMT", "jcl_steps": ["STEP040"]},
    {"case": "carddemo-tranidx", "job": "TRANIDX", "jcl_steps": ["STEP20", "STEP25", "STEP30"]}
  ]
}
