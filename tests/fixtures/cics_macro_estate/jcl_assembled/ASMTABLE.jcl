//ASMTBL   JOB (ACCT),'ASSEMBLE TABLES',CLASS=A
//ASM      EXEC PGM=ASMA90,PARM='OBJECT,NODECK'
//SYSLIB   DD DSN=CICS.SDFHMAC,DISP=SHR
//SYSIN    DD *
DFHFCT   CSECT
         DFHFCT TYPE=INITIAL,SUFFIX=01
         DFHFCT TYPE=FILE,FILE=ACCTDAT,DSNAME=BANK.ACCT.DAM,KEYLEN=11
         DFHSRT TYPE=USER,ABCODE=(4321),RECOVER=YES
         DFHFCT TYPE=FINAL
         END
