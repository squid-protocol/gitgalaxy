 DEFINE FILE(CUSTDAT) GROUP(BANK)
        DSNAME(BANK.CUST.OTHER) RECORDFORMAT(V) KEYLENGTH(16)
 DEFINE FILE(CSDONLY) GROUP(BANK)
        DSNAME(BANK.CSD.ONLY)
 DEFINE TRANSACTION(BA01) GROUP(BANK)
        PROGRAM(BANKINQ) PROFILE(DFHCICST)
 DEFINE TRANSACTION(BA02) GROUP(BANK)
        PROGRAM(BANKXFR) PROFILE(DFHCICST)
 DEFINE PROGRAM(BANKINQ) GROUP(BANK) LANGUAGE(COBOL)
 DEFINE MAPSET(BANKMAP) GROUP(BANK)
 DEFINE TDQUEUE(AUDT) GROUP(BANK)
        TYPE(EXTRA) DDNAME(AUDITDD) RECORDFORMAT(VARIABLE) BLOCKFORMAT(BLOCKED)
        RECORDSIZE(132)
 DEFINE TDQUEUE(CSSL) GROUP(BANK)
